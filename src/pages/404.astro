---
import BaseLayout from "../../shared/components/BaseLayout.astro";
import { COMPANIES_SITE_URL } from "../../shared/config/config";

const siteTitle = "China Used Car Companies";
const title = "Page Not Found — China Used Car Companies";
---

<BaseLayout
  siteTitle={siteTitle}
  siteUrl={COMPANIES_SITE_URL}
  currentSection="companies"
  title={title}
  description="The page you are looking for could not be found."
  canonical="/404/"
>
  <div class="notfound">
    <h1>Page not found</h1>
    <p class="lede">
      The page you're looking for doesn't exist or may have moved.
    </p>
    <ul>
      <li><a href="/">Back to the Companies home</a></li>
      <li><a href="/automakers/">Browse automakers</a></li>
      <li><a href="/used-car-exporters/">Browse used car exporters</a></li>
    </ul>
  </div>

  <style>
    .notfound { padding: var(--space-7) 0; max-width: 60ch; }
    .notfound h1 { font-size: 28px; }
    .lede { color: var(--color-text-soft); font-size: 17px; }
  </style>
</BaseLayout>
