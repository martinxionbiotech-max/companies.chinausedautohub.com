---
import { verificationLabel, verificationBadgeClass } from "../lib/companies";

interface Props {
  status: string;
}
const { status } = Astro.props;
const label = verificationLabel(status);
const cls = verificationBadgeClass(status);
---
<span class={`badge ${cls}`}>{label}</span>
<style>
  .v-verified { background: #e3f2e9; color: var(--color-success); }
  .v-listed { background: #e3effa; color: var(--color-accent); }
  .v-source { background: #e0f2f1; color: #0f766e; }
  .v-unverified { background: var(--color-bg-alt); color: var(--color-text-soft); }
</style>
