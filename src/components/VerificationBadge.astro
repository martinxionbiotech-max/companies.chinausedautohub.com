---
import { verificationLabel, verificationBadgeClass } from "../lib/companies";

interface Props {
  status: string;
}
const { status } = Astro.props;
const label = verificationLabel(status);
const cls = verificationBadgeClass(status);
---
<span class={`badge ${cls}`}>{label}</span>
<style>
  .v-listed { background: var(--color-bg-alt); color: var(--color-text-soft); }
  .v-info { background: #fdf3dc; color: var(--color-warning); }
  .v-source { background: #e3effa; color: var(--color-accent); }
  .v-website { background: #e8f0f8; color: var(--color-accent); }
  .v-registration { background: #e3f2e9; color: var(--color-success); }
</style>
